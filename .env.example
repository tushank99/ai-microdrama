# Copy to .env and fill in. At least one key enables LLM scoring; with none, rules-only scoring is used.
LLM_PROVIDER=groq          # groq | gemini | openai | anthropic | claude_cli | none
LLM_MODEL=                 # blank = provider default

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=           # optional, for OpenAI-compatible endpoints
ANTHROPIC_API_KEY=
